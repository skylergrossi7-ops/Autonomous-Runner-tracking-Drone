import math
import time

import cv2
from ultralytics import YOLO

try:
    from dronekit import VehicleMode, connect
    from pymavlink import mavutil
except ImportError:
    VehicleMode = None
    connect = None
    mavutil = None

VIDEO_SOURCE = r'import downloaded video here'
PERSON_CLASS_ID = 0
CONFIDENCE_THRESHOLD = 0.45
MAX_TARGET_LOST_SECONDS = 2.0
TARGET_TAKEOFF_ALTITUDE = 20

target_runner_id = None
target_last_seen_time = None

# vehicle = connect('drone adress here', wait_ready=True) # connect the vehicle


# Turn onboard camera on - cv2.VideoCapture(0)
video_feed = cv2.VideoCapture(VIDEO_SOURCE)

if not video_feed.isOpened():
    print("Could not open video source")
    exit()

print('Streaming started. Press q in video window to stop')

# Load pretrained YOLO detection model
model = YOLO('yolov8n.pt')


def select_initial_target(boxes):
    best_box = None
    best_id = None
    highest_conf = 0.0

    for box in boxes:
        if box.id is None:
            continue

        class_id = int(box.cls.item())
        confidence = float(box.conf.item())

        if class_id != PERSON_CLASS_ID:
            continue

        if confidence > highest_conf:
            highest_conf = confidence
            best_box = box
            best_id = int(box.id.item())

    return best_id, best_box


def find_existing_target(boxes, target_id):
    for box in boxes: #loos at each detected object
        if box.id is None:
            continue

        class_id = int(box.cls.item()) # checks what the object is, ie human etc
        current_id = int(box.id.item()) # checks tracking id for that object

        if class_id == PERSON_CLASS_ID and current_id == target_id:
            return box

    return None

def draw_target(frame, box, label):
    x1, y1, x2, y2 = map(int, box.xyxy[0])
    confidence = float(box.conf.item())
    cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 0, 255), 2)
    cv2.putText(frame, f'{label} conf={confidence: .2f}',(x1, y1-10),
                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0, 0, 255), 2) #(blue, green, red)

def calculate_target_offset(frame,target_box):
    x1, y1, x2, y2 = map(float, target_box.xyxy[0])
    frame_height, frame_width = frame.shape[:2]

    frame_center_x = frame_width / 2
    frame_center_y = frame_height / 2

    runner_x = (x1 +x2) / 2
    runner_y = (y1 + y2) / 2

    offset_x = (runner_x / 2) / (frame_width / 2)
    offset_y = (runner_y / 2) / (frame_height / 2)

    return offset_x, offset_y


def search():
    global target_runner_id
    global target_last_seen_time


    while True:
        ret, frame = video_feed.read()

        if not ret:
            print('Could not read camera feed')
            break

        frame = cv2.resize(frame, (960, 540))

        results = model.track(frame, persist = True, verbose = False, conf = CONFIDENCE_THRESHOLD, classes = [PERSON_CLASS_ID])
        boxes = results[0].boxes if results and len(results) > 0 else [] # gets detected boxes from yolo
        target_box = None

        if target_runner_id is None:
            target_runner_id, target_box = select_initial_target(boxes) # chooses first target with highest confidence
            if target_runner_id is not None: # if a runner was found save time
                target_last_seen_time = time.time()
                print(f'Locked onto runner ID {target_runner_id}')
        else:
            target_box = find_existing_target(boxes, target_runner_id) # look through current boxes for locked target runner

            if target_box is not None:
                target_last_seen_time = time.time() # if locked runner was found in this frame, update last seen time
            else:
                time_since_seen = time.time() - target_last_seen_time # if runner was not found, calculate how long they have been missing

                # if runner has been missing for too long, unlock runner so next loop can choose new runner
                if time_since_seen > MAX_TARGET_LOST_SECONDS:
                    print(f'Lost runner ID {target_runner_id}')
                    target_runner_id = None
                    target_last_seen_time = None

        if target_box is not None: # target runner is visible in current frame so we can begin to calculate offsets
            offset_x, offset_y = calculate_target_offset(frame, target_box)

            draw_target(frame,target_box, f'TARGET ID {target_runner_id}')
            print(f'offset_x={offset_x:.1f},offset_y={offset_y:.1f}')


        cv2.imshow('Runner Tracking', frame)

        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

search()
video_feed.release()
cv2.destroyAllWindows()

