<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="drone_world">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required Gazebo systems -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <!-- Required for the monocular RGB camera -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.8 0.8 0.8 1</background>
    </scene>

    <!-- Sun -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>30 30</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Simple human-shaped obstacle -->
    <model name="person">
      <static>true</static>
      <pose>5 0 0 0 0 3.14159</pose>

      <link name="person_link">

        <!-- Collision used by the simulator -->
        <collision name="body_collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>1.8</length>
            </cylinder>
          </geometry>
        </collision>

        <!-- Torso -->
        <visual name="torso">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 0.3 0.8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.8 1</ambient>
            <diffuse>0.1 0.2 0.8 1</diffuse>
          </material>
        </visual>

        <!-- Head -->
        <visual name="head">
          <pose>0 0 1.85 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.2</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.8 0.6 0.4 1</ambient>
            <diffuse>0.8 0.6 0.4 1</diffuse>
          </material>
        </visual>

        <!-- Legs -->
        <visual name="left_leg">
          <pose>0 0.13 0.45 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </visual>

        <visual name="right_leg">
          <pose>0 -0.13 0.45 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.1</radius>
              <length>0.9</length>
            </cylinder>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Initial drone platform -->
    <model name="drone">
      <!-- Keep it static while developing the perception and costmap code.
           A dynamic drone needs motors and a flight controller. -->
      <static>true</static>
      <pose>0 0 1.2 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>1.5</mass>
          <inertia>
            <ixx>0.03</ixx>
            <iyy>0.03</iyy>
            <izz>0.05</izz>
          </inertia>
        </inertial>

        <collision name="body_collision">
          <geometry>
            <box>
              <size>0.5 0.5 0.12</size>
            </box>
          </geometry>
        </collision>

        <visual name="body_visual">
          <geometry>
            <box>
              <size>0.5 0.5 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>

        <!-- Arms -->
        <visual name="arm_x">
          <geometry>
            <box>
              <size>0.9 0.06 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <visual name="arm_y">
          <geometry>
            <box>
              <size>0.06 0.9 0.04</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
          </material>
        </visual>

        <!-- Forward monocular camera. Depth is inferred on the laptop. -->
        <sensor name="runner_camera" type="camera">
          <pose>0.25 0 0.05 0 0 0</pose>
          <topic>/camera/image_raw</topic>
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.3962634</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.1</near>
              <far>100.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
