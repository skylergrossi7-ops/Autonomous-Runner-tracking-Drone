Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Raw Depth Anything Cloud1
        - /Filtered Environment Cloud1
        - /Local Voxel Costmap1
      Splitter Ratio: 0.55
    Tree Height: 720
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
    SyncSource: ""
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 35; 35
    Fixed Frame: odom
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Alpha: 0.5
      Cell Size: 1
      Color: 120; 120; 120
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Name: Raw Depth Anything Cloud
      Enabled: true
      Alpha: 0.55
      Topic:
        Value: /camera/depth_ai/points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Decay Time: 15.0
      Selectable: true
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 70; 70
    - Class: rviz_default_plugins/PointCloud2
      Name: Filtered Environment Cloud
      Enabled: true
      Alpha: 0.85
      Topic:
        Value: /camera/depth_ai/filtered_points
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Style: Points
      Size (Pixels): 3
      Size (m): 0.015
      Decay Time: 15.0
      Selectable: true
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 40; 220; 90
    - Class: rviz_default_plugins/Map
      Name: Local Voxel Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Alpha: 0.7
      Color Scheme: costmap
      Draw Behind: false
    - Class: rviz_default_plugins/Image
      Name: Iris RGB Camera
      Enabled: true
      Topic:
        Value: /camera/image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: YOLO Bounding Boxes
      Enabled: true
      Topic:
        Value: /perception/debug_image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Normalize Range: true
    - Class: rviz_default_plugins/Image
      Name: Depth Anything Depth
      Enabled: true
      Topic:
        Value: /camera/depth_ai/depth_image
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Normalize Range: true
      Min Value: 0
      Max Value: 20
      Median window: 5
    - Class: rviz_default_plugins/TF
      Name: TF Frames
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.6
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/Axes
      Name: Drone Base Axes
      Enabled: true
      Reference Frame: base_link
      Length: 1
      Radius: 0.05
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D Mapping View
      Distance: 10
      Focal Point:
        X: 0
        Y: 4
        Z: 0.8
      Pitch: 0.55
      Yaw: 3.14
      Near Clip Distance: 0.01
      Target Frame: odom
Window Geometry:
  Height: 900
  Width: 1500
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false
