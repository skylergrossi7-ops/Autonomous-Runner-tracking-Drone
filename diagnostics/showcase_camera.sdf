<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- Spawned only after takeoff so documentation rendering cannot interfere
       with SITL initialization, arming, or the takeoff command path. -->
  <model name="showcase_camera_rig">
    <static>true</static>
    <pose>-5.0 4.5 3.5 0 0 0</pose>
    <link name="camera_link">
      <sensor name="showcase_camera" type="camera">
        <pose>0 0 0 0 0.25 0</pose>
        <topic>showcase_camera/image</topic>
        <update_rate>5</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.5707963</horizontal_fov>
          <image>
            <width>480</width>
            <height>270</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
